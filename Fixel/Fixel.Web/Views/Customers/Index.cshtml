@model IEnumerable<Fixel.ViewModels.Customers.Index.CustomerIndexViewModel>

@{
    ViewData["Title"] = "Customers";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fs-3 fw-semibold mb-0">Customers</h1>
    <a class="btn btn-primary" asp-action="Create">Add customer</a>
</div>

<div class="card overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th scope="col">Name</th>
                    <th scope="col">Phone</th>
                    <th scope="col">Email</th>
                    <th scope="col" class="text-end">Devices</th>
                    <th scope="col" class="text-end">Active repairs</th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var customer in Model)
                {
                    <tr>
                        <td>
                            <a class="fw-medium link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover"
                               asp-action="Details" asp-route-id="@customer.Id">@customer.FirstName @customer.LastName</a>
                        </td>
                        <td class="num">@customer.PhoneNumber</td>
                        <td>@Html.DisplayFor(modelItem => customer.Email)</td>
                        <td class="text-end">@customer.DevicesCount</td>
                        <td class="text-end">@customer.ActiveTicketsCount</td>
                        <td class="text-end">
                            <a asp-action="Update" asp-route-id="@customer.Id">Edit</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-body-secondary">No customers found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
