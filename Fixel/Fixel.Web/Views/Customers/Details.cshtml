@model Fixel.ViewModels.Customers.Details.CustomerDetailsViewModel

@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fs-3 fw-semibold mb-0">@Model.FirstName @Model.LastName</h1>
    <div class="d-flex gap-3">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <aside class="card">
            <div class="card-body">
                <h2 class="fs-5 fw-semibold mb-3">Contact</h2>
                <dl class="mb-0">
                    <dt class="small fw-normal text-body-secondary">Phone</dt>
                    <dd class="mb-3 num"><a href="tel:@Model.PhoneNumber">@Model.PhoneNumber</a></dd>

                    <dt class="small fw-normal text-body-secondary">Email</dt>
                    <dd class="mb-3 text-break">@Html.DisplayFor(model => model.Email)</dd>

                    <dt class="small fw-normal text-body-secondary">Preferred contact method</dt>
                    <dd class="mb-0">@Model.PreferredContactMethod</dd>
                </dl>
            </div>
        </aside>
    </div>

    <div class="col-lg-8">
        <div class="d-grid gap-4">
            <section class="card overflow-hidden">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-baseline py-3">
                    <h2 class="fs-5 fw-semibold mb-0">Devices</h2>
                    <span class="text-body-secondary">@Model.Devices.Count()</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Device</th>
                                <th scope="col">Type</th>
                                <th scope="col">Serial number</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var device in Model.Devices)
                            {
                                <tr>
                                    <td class="fw-medium">@device.ManufacturerName @device.DeviceModel</td>
                                    <td>@device.DeviceType</td>
                                    <td class="num">@Html.DisplayFor(modelItem => device.SerialNumber)</td>
                                </tr>
                            }
                            @if (!Model.Devices.Any())
                            {
                                <tr><td colspan="3" class="text-body-secondary">No devices yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>

            <section class="card overflow-hidden">
                <div class="card-header bg-transparent d-flex justify-content-between align-items-baseline py-3">
                    <h2 class="fs-5 fw-semibold mb-0">Repair history</h2>
                    <span class="text-body-secondary">@Model.RepairTickets.Count()</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th scope="col">Reference</th>
                                <th scope="col">Device</th>
                                <th scope="col">Status</th>
                                <th scope="col">Intake date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ticket in Model.RepairTickets)
                            {
                                <tr>
                                    <td class="fw-medium num">@ticket.ReferenceNumber</td>
                                    <td>@ticket.DeviceManufacturerName @ticket.DeviceModelName</td>
                                    <td><partial name="_StatusBadge" model="ticket.RepairStatus" /></td>
                                    <td class="num">@Html.DisplayFor(modelItem => ticket.IntakeDate)</td>
                                </tr>
                            }
                            @if (!Model.RepairTickets.Any())
                            {
                                <tr><td colspan="4" class="text-body-secondary">No repairs yet.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h2 class="modal-title fs-5 fw-semibold" id="deleteModalLabel">Delete @Model.FirstName @Model.LastName?</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-body-secondary">
                Their devices and repair tickets will be kept without an owner. This can’t be undone.
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    <button type="submit" class="btn btn-danger">Delete customer</button>
                </form>
            </div>
        </div>
    </div>
</div>
