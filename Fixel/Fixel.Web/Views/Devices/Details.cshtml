@using Fixel.Web.Extensions
@model Fixel.ViewModels.Devices.Details.DeviceDetailsViewModel

@{
    ViewData["Title"] = $"{Model.ManufacturerName} {Model.ModelName}";
    bool hasTickets = Model.RepairTickets.Any();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h1 class="fs-3 fw-semibold mb-0">@Model.ManufacturerName @Model.ModelName</h1>
    <div class="d-flex gap-3">
        <a asp-action="Update" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Edit</a>
        @if (!hasTickets)
        {
            <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">Delete</button>
        }
        else
        {
            <button type="button" class="btn btn-outline-danger" disabled title="Devices with repair history cannot be deleted">Delete</button>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="d-grid gap-4">
            <aside class="card">
                <div class="card-body">
                    <h2 class="fs-5 fw-semibold mb-3">Specifications</h2>
                    <dl class="mb-0">
                        <dt class="small fw-normal text-body-secondary">Manufacturer</dt>
                        <dd class="mb-3">@Model.ManufacturerName</dd>

                        <dt class="small fw-normal text-body-secondary">Model</dt>
                        <dd class="mb-3 fw-medium">@Model.ModelName</dd>

                        <dt class="small fw-normal text-body-secondary">Type</dt>
                        <dd class="mb-3">@Model.DeviceType</dd>

                        <dt class="small fw-normal text-body-secondary">Serial number</dt>
                        <dd class="mb-0 num @(Model.SerialNumber is null ? "text-secondary" : null)">
                            @Html.DisplayFor(model => model.SerialNumber)
                        </dd>
                    </dl>
                </div>
            </aside>

            <aside class="card">
                <div class="card-body">
                    <h2 class="fs-5 fw-semibold mb-3">Owner</h2>
                    <dl class="mb-0">
                        <dt class="small fw-normal text-body-secondary">Name</dt>
                        <dd class="mb-3 @(Model.CustomerId is null ? "text-secondary" : null)">
                            @if (Model.CustomerId is not null)
                            {
                                <a class="fw-medium link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover"
                                   asp-controller="Customers" asp-action="Details" asp-route-id="@Model.CustomerId">
                                    @Model.CustomerFirstName @Model.CustomerLastName
                                </a>
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.CustomerFirstName)
                            }
                        </dd>

                        <dt class="small fw-normal text-body-secondary">Phone</dt>
                        <dd class="mb-3 num @(Model.CustomerPhoneNumber is null ? "text-secondary" : null)">
                            @if (Model.CustomerPhoneNumber is not null)
                            {
                                <a href="tel:@Model.CustomerPhoneNumber">@Model.CustomerPhoneNumber</a>
                            }
                            else
                            {
                                @Html.DisplayFor(model => model.CustomerPhoneNumber)
                            }
                        </dd>

                        <dt class="small fw-normal text-body-secondary">Email</dt>
                        <dd class="mb-0 text-break @(Model.CustomerEmail is null ? "text-secondary" : null)">
                            @Html.DisplayFor(model => model.CustomerEmail)
                        </dd>
                    </dl>
                </div>
            </aside>
        </div>
    </div>

    <div class="col-lg-8">
        <section class="card overflow-hidden">
            <div class="card-header bg-transparent d-flex justify-content-between align-items-baseline py-3">
                <h2 class="fs-5 fw-semibold mb-0">Repair history</h2>
                <span class="text-body-secondary">@Model.RepairTickets.Count()</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th scope="col">Reference</th>
                            <th scope="col">Reported problem</th>
                            <th scope="col">Status</th>
                            <th scope="col">Priority</th>
                            <th scope="col">Intake date</th>
                            <th scope="col">Expected</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.RepairTickets)
                        {
                            <tr class="position-relative">
                                <td>
                                    <a class="ref num fw-medium link-body-emphasis link-underline-opacity-0 link-underline-opacity-100-hover stretched-link"
                                       asp-controller="RepairTickets" asp-action="Details" asp-route-id="@ticket.Id">@ticket.ReferenceNumber</a>
                                </td>
                                <td class="text-truncate" style="max-width: 240px;">@ticket.ReportedProblem</td>
                                <td><partial name="_StatusBadge" model="ticket.Status" /></td>
                                <td><span class="dot @ticket.Priority.ToPriorityDotClass()"></span>@ticket.Priority</td>
                                <td class="num">@Html.DisplayFor(modelItem => ticket.IntakeDate)</td>
                                <td class="num @(ticket.ExpectedCompletionDate is null ? "text-secondary" : null)">
                                    @if (ticket.IsOverdue)
                                    {
                                        <span class="text-danger fw-medium">@Html.DisplayFor(modelItem => ticket.ExpectedCompletionDate)</span>
                                        <span class="badge bg-danger-subtle text-danger-emphasis ms-2">Overdue</span>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => ticket.ExpectedCompletionDate)
                                    }
                                </td>
                            </tr>
                        }
                        @if (!Model.RepairTickets.Any())
                        {
                            <tr><td colspan="6" class="text-body-secondary">No repairs recorded for this device.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>

@if (!hasTickets)
{
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title fs-5 fw-semibold" id="deleteModalLabel">Delete @Model.ManufacturerName @Model.ModelName?</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-body-secondary">
                    This device has no repair history and will be permanently removed. This can’t be undone.
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                        <button type="submit" class="btn btn-danger">Delete device</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}