@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    bool IsActive(string controller) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

    var navItems = new[]
    {
        (Text: "Dashboard",   Controller: "Home"),
        (Text: "Tickets",     Controller: "Tickets"),
        (Text: "Customers",   Controller: "Customers"),
        (Text: "Devices",     Controller: "Devices"),
        (Text: "Technicians", Controller: "Technicians"),
        (Text: "Spare parts", Controller: "SpareParts")
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Fixel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header class="bg-white border-bottom">
        <nav class="navbar navbar-expand-md" aria-label="Main">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">Fixel</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                        aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav ms-md-4">
                        @foreach (var item in navItems)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(IsActive(item.Controller) ? "active" : null)"
                                   asp-controller="@item.Controller" asp-action="Index"
                                   aria-current="@(IsActive(item.Controller) ? "page" : null)">@item.Text</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container flex-grow-1 py-4 py-md-5">
        @RenderBody()
    </main>

    <footer class="border-top py-3 small text-body-secondary">
        <div class="container">&copy; Fixel</div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
