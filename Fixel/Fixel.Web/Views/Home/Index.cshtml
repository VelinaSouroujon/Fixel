@{
	ViewData["Title"] = "Dashboard";
}

<div class="mb-4">
	<h1 class="fs-3 fw-semibold mb-1">Dashboard</h1>
	<p class="text-body-secondary mb-0">Manage repair tickets, customer records, and device intake.</p>
</div>

<div class="row g-4">
	<div class="col-md-6">
		<div class="card h-100">
			<div class="card-body p-4 d-flex flex-column justify-content-between">
				<div>
					<h2 class="fs-5 fw-semibold mb-2">Repair tickets</h2>
					<p class="text-body-secondary mb-4">
						Track active repairs, check overdue jobs, or open a new intake ticket for a device.
					</p>
				</div>
				<div class="d-flex flex-wrap gap-2">
					<a asp-controller="RepairTickets" asp-action="Index" class="btn btn-outline-secondary">View all tickets</a>
					<a asp-controller="RepairTickets" asp-action="Create" class="btn btn-primary">New ticket</a>
				</div>
			</div>
		</div>
	</div>

	<div class="col-md-6">
		<div class="card h-100">
			<div class="card-body p-4 d-flex flex-column justify-content-between">
				<div>
					<h2 class="fs-5 fw-semibold mb-2">Customers</h2>
					<p class="text-body-secondary mb-4">
						Look up customer contact details, owned devices, and past repair history, or register a new customer.
					</p>
				</div>
				<div class="d-flex flex-wrap gap-2">
					<a asp-controller="Customers" asp-action="Index" class="btn btn-outline-secondary">View all customers</a>
					<a asp-controller="Customers" asp-action="Create" class="btn btn-primary">Add customer</a>
				</div>
			</div>
		</div>
	</div>
</div>